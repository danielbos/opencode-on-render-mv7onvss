#!/usr/bin/env bash
# git credential helper for github.com.
# Answers credential queries using GITHUB_TOKEN from the environment so
# clone, pull, and push work without storing the token on disk.
input="$(cat)"
case "$input" in
  *host=github.com*) ;;
  *) exit 0 ;;
esac
if [ -z "${GITHUB_TOKEN:-}" ]; then
  echo "git-credential-github: GITHUB_TOKEN is not set" >&2
  exit 1
fi
printf 'username=x-access-token\n'
printf 'password=%s\n' "$GITHUB_TOKEN"
